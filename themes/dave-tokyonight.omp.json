{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#7aa2f7",
          "template": "  "
        },
        {
          "type": "path",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#7dcfff",
          "template": "  {{ .Path }} ",
          "properties": {
            "style": "folder",
            "home_icon": "~",
            "folder_separator_icon": "  ",
            "max_depth": 5
          }
        },
        {
          "type": "git",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#9ece6a",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#e0af68{{ end }}"
          ],
          "template": " {{ .HEAD }} "
          ,
          "properties": {
            "branch_icon": " "
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#e0af68",
          "template": "  {{ .FormattedMs }} ",
          "properties": {
            "threshold": 2000
          }
        },
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "foreground": "#1a1b26",
          "background": "#565f89",
          "template": "  {{ .CurrentDate | date \"15:04\" }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#7aa2f7",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#f7768e{{ end }}"
          ],
          "template": "❯ "
        }
      ]
    }
  ]
}
